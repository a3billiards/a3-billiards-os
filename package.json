{
  "name": "a3-billiards-os",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "patch:expo-ngrok": "node scripts/patch-expo-ngrok.cjs",
    "sync:build-folder": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-to-build-folder.ps1",
    "build:preview-apks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-all-preview-apks.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "convex": "1.34.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "neverBuiltDependencies": [
      "amazon-ivs-react-native-player",
      "amazon-ivs-react-native-broadcast"
    ],
    "overrides": {
      "nodemailer": "link:packages/nodemailer-stub"
    }
  },
  "engines": {
    "node": ">=20"
  }
}