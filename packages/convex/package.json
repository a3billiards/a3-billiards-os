{
  "name": "@a3/convex",
  "version": "1.0.0",
  "exports": {
    "./_generated/api": {
      "types": "./_generated/api.d.ts",
      "default": "./_generated/api.js"
    },
    "./_generated/dataModel": {
      "types": "./_generated/dataModel.d.ts",
      "default": "./_generated/dataModel.d.ts"
    },
    "./*": "./*"
  },
  "scripts": {
    "dev": "pnpm exec convex dev",
    "deploy": "pnpm exec convex deploy",
    "typecheck": "tsc --noEmit",
    "seed:test-owner": "node ../../scripts/convex-seed/run-seed-test-owner.cjs",
    "seed:test-admin": "node ../../scripts/convex-seed/run-seed-test-admin.cjs",
    "seed:clear-admin-mfa": "node ../../scripts/convex-seed/run-clear-admin-mfa-rate-limit.cjs",
    "seed:test-club": "node ../../scripts/convex-seed/run-seed-test-club-for-user.cjs"
  },
  "dependencies": {
    "@a3/utils": "workspace:*",
    "@aws-sdk/client-ivs": "^3.758.0",
    "@convex-dev/auth": "0.0.68",
    "bcryptjs": "^3.0.3",
    "convex": "1.34.1",
    "convex-helpers": "^0.1.60",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucia": "^3.2.2",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9"
  }
}