# Set secrets on your Convex deployment (run from packages/convex).
# Replace placeholder values with your real AWS credentials — do not commit secrets.

npx convex env set AWS_IVS_REGION ap-south-1
npx convex env set AWS_IVS_ACCESS_KEY_ID your_access_key_id
npx convex env set AWS_IVS_SECRET_ACCESS_KEY your_secret_access_key
npx convex env set AWS_IVS_PLAYBACK_AUTH_KEY_PAIR_ID arn:aws:ivs:REGION:ACCOUNT:playback-key/KEY_ID
npx convex env set AWS_IVS_PLAYBACK_AUTH_PRIVATE_KEY "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
npx convex env set AWS_EVENTBRIDGE_WEBHOOK_SECRET your_random_shared_secret

# EventBridge API Destination must send header:
#   X-A3-EventBridge-Secret: <same value as AWS_EVENTBRIDGE_WEBHOOK_SECRET>
# Webhook URL (after deploy):
#   https://<your-deployment>.convex.site/webhooks/ivs-events
