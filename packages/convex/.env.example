# Convex deployment secrets — set on the deployment, NOT in git.
# From packages/convex:
#   npx convex env set VAR_NAME value
#
# Local dev may mirror values in packages/convex/.env.local (gitignored).

# ── Site URLs ────────────────────────────────────────────────────────────────
# CONVEX_SITE_URL=https://your-deployment.convex.site
# ONBOARDING_WEB_URL=https://onboarding.example.com

# ── Razorpay (server secret + public key id) ───────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_here
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
# RAZORPAY_PLAN_MONTHLY_PAISE=99900
# RAZORPAY_PLAN_YEARLY_PAISE=999900

# ── Email (Resend) ─────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxx

# ── Firebase / FCM (server-only service account JSON, single line) ─────────
# FIREBASE_PROJECT_ID=a3-billiards-os
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────
# WHATSAPP_PHONE_ID=123456789012345
# WHATSAPP_API_TOKEN=your_meta_token
# WHATSAPP_VERIFY_TOKEN=random_string_for_webhook_challenge
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_OTP_TEMPLATE_NAME=a3_billiards_otp
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en

# ── Google (server-side token verification + geocoding) ────────────────────
# GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_MAPS_API_KEY=your_server_geocoding_key

# ── AWS IVS live streaming ───────────────────────────────────────────────────
# AWS_IVS_REGION=ap-south-1
# AWS_IVS_ACCESS_KEY_ID=your_access_key_id
# AWS_IVS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_IVS_PLAYBACK_AUTH_KEY_PAIR_ID=arn:aws:ivs:REGION:ACCOUNT:playback-key/KEY_ID
# AWS_IVS_PLAYBACK_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AWS_EVENTBRIDGE_WEBHOOK_SECRET=your_random_shared_secret

# ── Auth / links ───────────────────────────────────────────────────────────
# PASSWORD_RESET_URL=https://your-deployment.convex.site/reset-password
# PASSCODE_RESET_URL=https://onboarding.example.com/reset-passcode
# CANCEL_DELETION_URL=https://your-deployment.convex.site/cancel-deletion

# ── Platform GST (subscription invoices) ───────────────────────────────────
# A3_SUBSCRIPTION_GST_RATE=18
# A3_PLATFORM_GST_SPLIT=cgst_sgst
# A3_PLATFORM_GSTIN=your_gstin
# A3_PLATFORM_LEGAL_NAME=A3 Billiards OS

# ── Rate limits (optional) ─────────────────────────────────────────────────
# OTP_RATE_LIMIT_WINDOW_MS=3600000
# OTP_RATE_LIMIT_MAX_PER_WINDOW=5
# OWNER_EXPORT_COOLDOWN_MS=3600000
