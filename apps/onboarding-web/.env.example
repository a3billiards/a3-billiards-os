# Onboarding SPA — copy to .env.local (gitignored). VITE_* vars are bundled into the browser.

# Convex deployment URL (public — not a secret)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Google Sign-In (Web client ID — public by Google design). Add this origin in Google Cloud Console → Authorized JavaScript origins.
VITE_GOOGLE_WEB_CLIENT_ID=

# Optional observability (client SDK keys — restrict by domain in vendor dashboards)
VITE_SENTRY_DSN=
VITE_POSTHOG_API_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
