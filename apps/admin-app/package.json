{
  "name": "@a3/admin-app",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/stop-expo-dev.ps1",
    "start": "expo start --dev-client --tunnel",
    "start:lan": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:apk": "powershell -NoProfile -Command \"$env:SENTRY_DISABLE_AUTO_UPLOAD='true'; Set-Location android; .\\gradlew.bat assembleRelease\"",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "build:apk": "eas build --profile preview --platform android",
    "build:dev-apk": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@a3/convex": "workspace:*",
    "@a3/i18n": "workspace:*",
    "@a3/ui": "workspace:*",
    "@a3/utils": "workspace:*",
    "@convex-dev/auth": "0.0.68",
    "@expo/metro-runtime": "~55.0.9",
    "@sentry/react-native": "~7.11.0",
    "convex": "^1.13.0",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-font": "~55.0.6",
    "expo-linking": "~55.0.13",
    "expo-localization": "~55.0.8",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "posthog-react-native": "^3.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.18.0",
    "eslint-config-expo": "^55.0.0"
  }
}
